{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.tritechchannel.com/sitemap.xml" },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|zalo|twitterbot|linkedinbot|telegrambot|whatsapp|slackbot|discordbot|skypeuripreview|pinterest).*"
        }
      ],
      "destination": "https://api.tritechchannel.com/share/blog/:slug"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
